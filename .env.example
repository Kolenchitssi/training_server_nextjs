# Application
PORT=8000
NODE_ENV=development

# Azure Application Insights (optional — leave empty for local dev without telemetry)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
# AZURE_STORAGE_CONTAINER_NAME=hiqo-portal-stg

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=86400

# MySQL Database
# Prisma requires DATABASE_URL in the following format:
# DATABASE_URL="mysql://username:password@host:port/database_name"
DATABASE_URL="mysql://laraveluser:admin@localhost:3306/portal_api?schema=public"
# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/mydatabase
